'# DataTutor 环境变量配置
# 复制此文件为 .env 并填入真实值

SECRET_KEY=your-secret-key-here

# 讯飞星火 API
XUNFEI_APP_ID=your-app-id
XUNFEI_API_KEY=your-api-key
XUNFEI_API_SECRET=your-api-secret

# 讯飞星火工作流 Agent Flow ID
XUNFEI_FLOW_TRAINING=your-training-flow-id
XUNFEI_FLOW_KNOWLEDGE=your-knowledge-flow-id
XUNFEI_FLOW_TEACHER=your-teacher-flow-id
XUNFEI_FLOW_REPORT=your-report-flow-id

# MySQL
MYSQL_URL=mysql+pymysql://root:password@127.0.0.1:3307/datatutor

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# VMWare VM SSH
VM_HOST=your-vm-ip
VM_PORT=22
VM_USER=your-vm-user
VM_PASSWORD=your-vm-password

# Doris (可选)
DORIS_HOST=127.0.0.1
DORIS_PORT=9030
DORIS_USER=root
DORIS_PASSWORD=

